	<key>NSAudioCaptureUsageDescription</key>
	<string>BangBar uses music audio levels to animate the live playback indicator.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>BangBar shows your next upcoming meeting for today.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>BangBar shows your next upcoming meeting for today.</string>
	<key>NSCameraUsageDescription</key>
	<string>BangBar uses the camera for the mirror widget.</string>
	<key>NSLocationUsageDescription</key>
	<string>BangBar uses your location to show the Moon's real orientation in the sky.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>BangBar shows your tasks due today.</string>
</dict>
</plist>
